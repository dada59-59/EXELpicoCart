; EXLSONDE v4 "oscilloscope" : a chaque front descendant de /ROM_CS (GP23),
; 64 instantanes de GP0-GP31 (A0-A14, D0-D7, /ROM_CS), un toutes les 4 cycles
; (20 ns a 200 MHz), soit ~1,3 us : l'acces entier et ce qui suit sa fin.
; Un mot de 32 bits par instantane (autopush).
.program oscillo
.wrap_target
    wait 1 gpio 23          ; /ROM_CS au repos
    wait 0 gpio 23          ; debut d'un acces
    set y, 1                ; 2 x 32 instantanes
paquet:
    set x, 31
instant:
    in pins, 32 [2]         ; 3 cycles ...
    jmp x--, instant        ; ... + 1 = 4 cycles par instantane
    jmp y--, paquet         ; (+2 cycles entre les deux paquets de 32)
.wrap

; Variante "A1" (exlsonde_a1, exlsonde_a1_eprom) : declenchee par la descente du
; doigt A1 du port cartouche (NROMCS), relie par un fil volant a GP26 ; le doigt
; A8 (SPARIN7) va sur GP27. Une ecriture dans la zone cartouche, qui ne fait pas
; descendre B1 (/ROM_CS ici), est ainsi vue elle aussi -- si NROMCS descend.
; Filtre : A1 doit etre encore a 0 80 ns apres sa descente (le premier releve, sur
; une EXL100, n'a montre que des pointes de 20 ns, sans B1 : decodage des adresses
; qui "pique" quand les adresses changent, ou diaphonie du fil volant) ; jmp pin = GP26.
.program oscillo_a1
.wrap_target
debut:
    wait 1 gpio 26          ; A1 au repos
    wait 0 gpio 26          ; A1 descend
    nop [15]                ; 16 cycles = 80 ns
    jmp pin debut           ; deja remonte : une pointe, on l'ignore
    set y, 1
paquet:
    set x, 31
instant:
    in pins, 32 [2]
    jmp x--, instant
    jmp y--, paquet
.wrap
