; EXLSONDE v4 "oscilloscope" : a chaque front descendant de /ROM_CS (GP23),
; 64 instantanes de GP0-GP31 (A0-A14, D0-D7, /ROM_CS), un toutes les 4 cycles
; (20 ns a 200 MHz), soit ~1,3 us : l'acces entier et ce qui suit sa fin.
; Un mot de 32 bits par instantane (autopush).
.program oscillo
.wrap_target
    wait 1 gpio 23          ; /ROM_CS au repos
    wait 0 gpio 23          ; debut d'un acces
    set y, 1                ; 2 x 32 instantanes
paquet:
    set x, 31
instant:
    in pins, 32 [2]         ; 3 cycles ...
    jmp x--, instant        ; ... + 1 = 4 cycles par instantane
    jmp y--, paquet         ; (+2 cycles entre les deux paquets de 32)
.wrap
