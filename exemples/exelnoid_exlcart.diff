+; ============================================================================
+; SOURIS USB sur EXLCART : la cartouche Pico tient un compteur X qui tourne sur
+; 8 bits (exl_mx) ; le deplacement est la difference avec la lecture precedente.
+; Resultat au format ExelMouse, pour que check_mouse/check_mouse_btn restent
+; inchanges : mouse_dx (0 = immobile, bit7 = vers la droite), mouse_btn_old
+; (boutons en bits 6,5, a 0 = appuye), et mouse_mag = |dx| borne a MOUSE_USB_MAX.
+; ============================================================================
+read_mouse_usb:                     ; (aucune pile en plus de la voie ExelMouse)
+        lda     @musb_lastx         ; A = lecture precedente
+        mov     A,B                 ; B = precedente
+        lda     @exl_mx             ; A = nouveau compteur X (tourne sur 8 bits)
+        sta     @musb_lastx         ; memoriser pour la prochaine fois
+        sub     B,A                 ; A = nouveau - precedent = deplacement signe
+        mov     %$80,B              ; B = sens : bit7 = vers la droite
+        cmp     %$80,A
+        jl      @rmu_mag            ; dx >= 0 : vers la droite (ou immobile)
+        inv     A
+        inc     A                   ; dx < 0 : A = |dx|
+        clr     B                   ; vers la gauche
+rmu_mag:
+        cmp     %MOUSE_USB_MAX,A    ; borne le pas
+        jl      @rmu_ok
+        mov     %MOUSE_USB_MAX,A
+rmu_ok:
+        sta     @mouse_mag
+        tsta
+        jz      @rmu_dx             ; immobile : mouse_dx = 0
+        or      B,A                 ; ajoute le sens
+rmu_dx:
+        sta     @mouse_dx
+        lda     @exl_mbtn           ; boutons : bit0 gauche, bit1 droit, bit2 milieu
+        and     %$07,A
+        mov     A,B
+        lda     @musb_btn_tab(B)
+        sta     @mouse_btn_old
+        rets
+musb_btn_tab:                       ; gauche -> bit6, droit -> bit5, milieu = gauche
+        .byte   $FF,$BF,$DF,$9F,$BF,$BF,$9F,$9F
+
+; menu : une souris USB vient d'etre signalee -> l'activer une fois (S la coupe)
+usb_mouse_auto:
+        lda     @musb_auto
+        jnz     @uma_done
+        lda     @exl_mpres
+        cmp     %$A5,A
+        jne     @uma_done
+        mov     %1,A
+        sta     @musb_auto
+        sta     @mouse_enabled
+        call    @sdm_draw_mouse_status
+uma_done:
+        rets
+
+; ----------------------------------------------------------------------------
+; ZONE D'ECHANGE EXLCART (16 octets) : la cartouche Pico la trouve grace a la
+; signature "EXLP" et y ecrit l'etat de la manette DB9 et de la souris USB.
+; Sur une vraie EPROM, ces octets restent a $00 : ni manette, ni souris.
+; ----------------------------------------------------------------------------
+exl_io:
+exl_joy0:       .byte   $00         ; manette DB9 : b0 haut b1 bas b2 gauche b3 droite b4 feu
+exl_joy1:       .byte   $00
+exl_jpres:      .byte   $00         ; $A5 = zone geree par EXLCART
+                .byte   $00
+                .byte   "EXLP"      ; signature : manette + souris
+exl_mx:         .byte   $00         ; souris : compteur X
+exl_my:         .byte   $00         ; souris : compteur Y
+exl_mbtn:       .byte   $00         ; souris : boutons
+exl_mpres:      .byte   $00         ; $A5 = souris branchee
+                .byte   $00,$00,$00,$00
+
 place_ball_on_paddle:
         clr     A
         sta     @ball_active
